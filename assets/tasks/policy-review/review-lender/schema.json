{
  "type": "object",
  "required": ["added", "endorsed", "disputed"],
  "properties": {
    "added": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clause_id", "severity", "summary"],
        "properties": {
          "clause_id": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "summary": {"type": "string"},
          "detail": {"type": ["string", "null"]}
        }
      }
    },
    "endorsed": {"type": "array", "items": {"type": "string"}},
    "disputed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "why"],
        "properties": {"id": {"type": "string"}, "why": {"type": "string"}}
      }
    }
  }
}
