{
  "type": "object",
  "required": ["facility_name", "hedging_requirements", "covenants", "reporting_duties", "restrictions"],
  "additionalProperties": false,
  "properties": {
    "facility_name": {"type": "string", "maxLength": 200},
    "hedging_requirements": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["kind", "description", "quote", "source"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["interest_rate", "currency", "commodity"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 400},
          "proportion_pct_min": {"type": "number", "minimum": 0, "maximum": 100},
          "exposure_tenor_months": {"type": "integer", "minimum": 0, "maximum": 360},
          "minimum_period_months": {"type": "integer", "minimum": 0, "maximum": 360},
          "currency": {"type": "string", "minLength": 3, "maxLength": 3},
          "instruments_permitted": {"type": "array", "maxItems": 10,
                                     "items": {"type": "string", "minLength": 1, "maxLength": 60}},
          "quote": {"type": "string", "minLength": 1, "maxLength": 300},
          "source": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "covenants": {
      "type": "array", "maxItems": 15,
      "items": {
        "type": "object", "required": ["name", "definition", "quote", "source"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "definition": {"type": "string", "minLength": 1, "maxLength": 400},
          "quote": {"type": "string", "minLength": 1, "maxLength": 300},
          "source": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "reporting_duties": {
      "type": "array", "maxItems": 15,
      "items": {
        "type": "object", "required": ["duty", "quote", "source"],
        "additionalProperties": false,
        "properties": {
          "duty": {"type": "string", "minLength": 1, "maxLength": 300},
          "frequency": {"type": "string", "maxLength": 60},
          "quote": {"type": "string", "minLength": 1, "maxLength": 300},
          "source": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    },
    "restrictions": {
      "type": "array", "maxItems": 15,
      "items": {
        "type": "object", "required": ["kind", "description", "quote", "source"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["indebtedness", "security", "hedging_counterparty",
                                             "speculation", "bank_accounts", "investments"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 400},
          "quote": {"type": "string", "minLength": 1, "maxLength": 300},
          "source": {"type": "string", "minLength": 1, "maxLength": 120}
        }
      }
    }
  }
}
