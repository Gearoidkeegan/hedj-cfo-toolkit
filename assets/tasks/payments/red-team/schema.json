{
  "type": "object",
  "required": ["routes"],
  "additionalProperties": false,
  "properties": {
    "routes": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["persona", "steps", "failed_control", "control_quote", "severity",
                     "closing_control", "closing_control_cost"],
        "additionalProperties": false,
        "properties": {
          "persona": {
            "type": "string",
            "enum": ["external_fraudster", "insider", "compromised_mailbox",
                     "cloned_voice", "poisoned_invoice"]
          },
          "steps": {
            "type": "array", "minItems": 1, "maxItems": 8,
            "items": {"type": "string", "minLength": 1, "maxLength": 300}
          },
          "failed_control": {"type": "string", "minLength": 1, "maxLength": 200},
          "control_quote": {"type": "string", "minLength": 1, "maxLength": 400},
          "control_source": {"type": "string", "maxLength": 120},
          "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
          "closing_control": {"type": "string", "minLength": 1, "maxLength": 300},
          "closing_control_cost": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    }
  }
}
