{
  "type": "object",
  "required": ["supplier_name", "invoice_number", "invoice_date", "due_date", "net", "vat",
               "gross", "currency", "payment_reference", "cost_category", "contact_email",
               "bic", "vat_number", "bill_to", "iban_location", "account_number_location"],
  "additionalProperties": false,
  "properties": {
    "supplier_name": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 200},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "invoice_number": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 80},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "invoice_date": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 10, "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})?$"},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "due_date": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 10, "pattern": "^(?:[0-9]{4}-[0-9]{2}-[0-9]{2})?$"},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "net": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 32,
                  "pattern": "^(?:-?[0-9]+(?:\\.[0-9]{1,4})?)?$"},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "vat": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 32,
                  "pattern": "^(?:-?[0-9]+(?:\\.[0-9]{1,4})?)?$"},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "gross": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 32,
                  "pattern": "^(?:-?[0-9]+(?:\\.[0-9]{1,4})?)?$"},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "currency": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 3, "pattern": "^(?:[A-Z]{3})?$"},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "payment_reference": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 140},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "cost_category": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 80},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "contact_email": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 200},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "bic": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 11},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "vat_number": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 32},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "bill_to": {
      "type": "object", "additionalProperties": false, "required": ["value", "quote"],
      "properties": {
        "value": {"type": "string", "maxLength": 200},
        "quote": {"type": "string", "maxLength": 400}
      }
    },
    "iban_location": {"type": "string", "maxLength": 60},
    "account_number_location": {"type": "string", "maxLength": 60}
  }
}
